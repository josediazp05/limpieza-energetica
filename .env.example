# --- Whop -------------------------------------------------------------------
# API key del dashboard de Whop (Developer / API Keys).
WHOP_API_KEY=
# ID de la compañía en Whop (empieza por biz_...).
WHOP_COMPANY_ID=
# Se genera al crear el webhook en Whop. Empieza por ws_...
WHOP_WEBHOOK_KEY=

# --- Planes del embudo ------------------------------------------------------
# El plan que cobra cada paso, tal como está en el dashboard (plan_...).
# Un paso sin plan NO cobra: deja pasar al comprador y lo apunta en el log.
WHOP_PLAN_MAIN=
WHOP_PLAN_UP1=
WHOP_PLAN_UP2=
WHOP_PLAN_DW1=
WHOP_PLAN_DW2=
WHOP_PLAN_COMBO=

# Precio anunciado de cada paso, en USD. No cobra nada —el importe lo pone el
# plan de Whop—: es el valor que se le manda a Meta para que pueda optimizar.
FUNNEL_VALOR_MAIN=
FUNNEL_VALOR_UP1=
FUNNEL_VALOR_UP2=
FUNNEL_VALOR_DW1=
FUNNEL_VALOR_DW2=
FUNNEL_VALOR_COMBO=

# --- Páginas del embudo -----------------------------------------------------
# Solo hace falta ponerlas para pisar las de `app/(funnel)/funnel.ts`.
# FUNNEL_VSL_URL=https://cristinalozano-constelaciones.com/vsl-maldiciones-familiares-2026/
# FUNNEL_UP1_URL=https://up1.cristinalozano-constelaciones.com/
# FUNNEL_UP2_URL=https://up2.cristinalozano-constelaciones.com/
# FUNNEL_DW1_URL=https://dw1.cristinalozano-constelaciones.com/
# FUNNEL_DW2_URL=https://dw2.cristinalozano-constelaciones.com/
# FUNNEL_GRACIAS_URL=https://graciaseml.cristinalozano-constelaciones.com/
# El COMBO 2X1 todavía no tiene página publicada. Mientras esté vacío, el "no
# quiero" del downsell 1 cae directo a la página de gracias.
FUNNEL_COMBO_URL=

# --- Sitio ------------------------------------------------------------------
# El dominio https de ESTE proyecto. Whop exige https en redirect_url, así que
# en local hay que apuntar acá el dominio real o el túnel de pruebas.
NEXT_PUBLIC_SITE_URL=

# --- Meta -------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Solo desarrollo: simula el país del comprador (el borde no lo resuelve en
# local). Decide shouldSaveCard(), o sea si el iframe ofrece PSE/Nequi/Pix.
DEV_COUNTRY=
